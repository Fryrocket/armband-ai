[Unit]
Description=Armband AI git auto-pull (rebase)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Edit WorkingDirectory / User if your clone path differs
WorkingDirectory=/home/pi/armband-ai
User=pi
ExecStart=/bin/bash /home/pi/armband-ai/scripts/git_auto_pull.sh
# 0 = success or intentional skip (dirty / up-to-date)
SuccessExitStatus=0
# Non-zero exits appear in journal for debugging
